# Salin file ini menjadi .env.local lalu isi nilainya (JANGAN commit .env.local).
# Buat kedua nilai auth sekaligus dengan: node scripts/set-owner-password.mjs "PasswordAnda"

# Lokasi database SQLite (default proyek).
DATABASE_URL="file:./dev.db"

# Auth Tahap 1 — gerbang password owner. KOSONG = aplikasi berjalan TANPA login
# (mode terbuka, banner peringatan tampil, deployment HOLD).
# Format: scrypt:<saltHex>:<hashHex> — hasil dari scripts/set-owner-password.mjs.
ZENAIDE_AUTH_HASH=

# Rahasia penanda tangan cookie sesi. Ganti nilai ini = semua sesi login dicabut.
ZENAIDE_SESSION_SECRET=
